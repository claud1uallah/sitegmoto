# PostgreSQL URI: encode reserved password characters with percent encoding.
# On IPv4-only networks use the exact Session pooler URI from Supabase Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DATABASE_SSL=require
# Optional trusted PEM root certificate if required by your Supabase TLS config.
DATABASE_SSL_CA=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
PUBLIC_SITE_URL=http://127.0.0.1:5173
# Enable only behind a proxy that overwrites x-real-ip and blocks direct access.
TRUST_PROXY=false
# Verified Supabase Auth UUIDs, comma-separated. Empty grants no admin access.
ADMIN_USER_IDS=
# Legacy loopback-only development identity; ignored with Supabase configured.
LOCAL_ADMIN_ENABLED=false
GTUNE_RUNTIME=node
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
